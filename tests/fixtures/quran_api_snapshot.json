{"audio_files":[{"verse_key":"94:4","url":"Alafasy/mp3/094004.mp3"}],"pagination":{"per_page":10,"current_page":1,"next_page":null,"total_pages":1,"total_records":1}}},"/verses/by_key/94:5":{"status":200,"json":{"verse":{"id":6095,"verse_number":5,"verse_key":"94:5","hizb_number":60,"rub_el_hizb_number":239,"ruku_number":538,"manzil_number":7,"sajdah_number":null,"text_uthmani":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","page_number":596,"juz_number":30,"translations":[{"id":102284,"resource_id":20,"text":"For indeed, with hardship [will be] ease [i.e., relief]."}]}}},"/recitations/7/by_ayah/94:5":{"status":200,"json":{"audio_files":[{"verse_key":"94:5","url":"Alafasy/mp3/094005.mp3"}],"pagination":{"per_page":10,"current_page":1,"next_page":null,"total_pages":1,"total_records":1}}},"/verses/by_key/94:6":{"status":200,"json":{"verse":{"id":6096,"verse_number":6,"verse_key":"94:6","hizb_number":60,"rub_el_hizb_number":239,"ruku_number":538,"manzil_number":7,"sajdah_number":null,"text_uthmani":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","page_number":596,"juz_number":30,"translations":[{"id":102286,"resource_id":20,"text":"Indeed, with hardship [will be] ease."}]}}},"/recitations/7/by_ayah/94:6":{"status":200,"json":{"audio_files":[{"verse_key":"94:6","url":"Alafasy/mp3/094006.mp3"}],"pagination":{"per_page":10,"current_page":1,"next_page":null,"total_pages":1,"total_records":1}}},"/verses/by_key/94:7":{"status":200,"json":{"verse":{"id":6097,"verse_number":7,"verse_key":"94:7","hizb_number":60,"rub_el_hizb_number":239,"ruku_number":538,"manzil_number":7,"sajdah_number":null,"text_uthmani":"فَإِذَا فَرَغْتَ فَٱنصَبْ","page_number":596,"juz_number":30,"translations":[{"id":102288,"resource_id":20,"text":"So when you have finished [your duties], then stand up [for worship]."}]}}},"/recitations/7/by_ayah/94:7":{"status":200,"json":{"audio_files":[{"verse_key":"94:7","url":"Alafasy/mp3/094007.mp3"}],"pagination":{"per_page":10,"current_page":1,"next_page":null,"total_pages":1,"total_records":1}}},"/verses/by_key/94:8":{"status":200,"json":{"verse":{"id":6098,"verse_number":8,"verse_key":"94:8","hizb_number":60,"rub_el_hizb_number":239,"ruku_number":538,"manzil_number":7,"sajdah_number":null,"text_uthmani":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","page_number":596,"juz_number":30,"translations":[{"id":102290,"resource_id":20,"text":"And to your Lord direct [your] longing."}]}}},"/recitations/7/by_ayah/94:8":{"status":200,"json":{"audio_files":[{"verse_key":"94:8","url":"Alafasy/mp3/094008.mp3"}],"pagination":{"per_page":10,"current_page":1,"next_page":null,"total_pages":1,"total_records":1}}},"/verses/by_key/112:1":{"status":200,"json":{"verse":{"id":6222,"verse_number":1,"verse_key":"112:1","hizb_number":60,"rub_el_hizb_number":240,"ruku_number":556,"manzil_number":7,"sajdah_number":null,"text_uthmani":" قُلْ هُوَ ٱللَّهُ أَحَدٌ","page_number":604,"juz_number":30,"translations":[{"id":96391,"resource_id":20,"text":"Say, \"He is Allāh, [who is] One,<sup foot_note=197829>1</sup>"}]}}},"/recitations/7/by_ayah/112:1":{"status":200,"json":{"audio_files":[{"verse_key":"112:1","url":"Alafasy/mp3/112001.mp3"}],"pagination":{"per_page":10,"current_page":1,"next_page":null,"total_pages":1,"total_records":1}}},"/verses/by_key/93:11":{"status":200,"json":{"verse":{"id":6090,"verse_number":11,"verse_key":"93:11","hizb_number":60,"rub_el_hizb_number":238,"ruku_number":537,"manzil_number":7,"sajdah_number":null,"text_uthmani":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","page_number":596,"juz_number":30,"translations":[{"id":102256,"resource_id":20,"text":"But as for the favor of your Lord, report [it]."}]}}},"/recitations/7/by_ayah/93:11":{"status":200,"json":{"audio_files":[{"verse_key":"93:11","url":"Alafasy/mp3/093011.mp3"}],"pagination":{"per_page":10,"current_page":1,"next_page":null,"total_pages":1,"total_records":1}}},"/verses/by_key/2:282":{"status":200,"json":{"verse":{"id":289,"verse_number":282,"verse_key":"2:282","hizb_number":5,"rub_el_hizb_number":19,"ruku_number":40,"manzil_number":1,"sajdah_number":null,"text_uthmani":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا تَدَايَنتُم بِدَيْنٍ إِلَىٰٓ أَجَلٍ مُّسَمًّى فَٱكْتُبُوهُ ۚ وَلْيَكْتُب بَّيْنَكُمْ كَاتِبٌۢ بِٱلْعَدْلِ ۚ وَلَا يَأْبَ كَاتِبٌ أَن يَكْتُبَ كَمَا عَلَّمَهُ ٱللَّهُ ۚ فَلْيَكْتُبْ وَلْيُمْلِلِ ٱلَّذِى عَلَيْهِ ٱلْحَقُّ وَلْيَتَّقِ ٱللَّهَ رَبَّهُۥ وَلَا يَبْخَسْ مِنْهُ شَيْـًٔا ۚ فَإِن كَانَ ٱلَّذِى عَلَيْهِ ٱلْحَقُّ سَفِيهًا أَوْ ضَعِيفًا أَوْ لَا يَسْتَطِيعُ أَن يُمِلَّ هُوَ فَلْيُمْلِلْ وَلِيُّهُۥ بِٱلْعَدْلِ ۚ وَٱسْتَشْهِدُوا۟ شَهِيدَيْنِ مِن رِّجَالِكُمْ ۖ فَإِن لَّمْ يَكُونَا رَجُلَيْنِ فَرَجُلٌ وَٱمْرَأَتَانِ مِمَّن تَرْضَوْنَ مِنَ ٱلشُّهَدَآءِ أَن تَضِلَّ إِحْدَىٰهُمَا فَتُذَكِّرَ إِحْدَىٰهُمَا ٱلْأُخْرَىٰ ۚ وَلَا يَأْبَ ٱلشُّهَدَآءُ إِذَا مَا دُعُوا۟ ۚ وَلَا تَسْـَٔمُوٓا۟ أَن تَكْتُبُوهُ صَغِيرًا أَوْ كَبِيرًا إِلَىٰٓ أَجَلِهِۦ ۚ ذَٰلِكُمْ أَقْسَطُ عِندَ ٱللَّهِ وَأَقْوَمُ لِلشَّهَـٰدَةِ وَأَدْنَىٰٓ أَلَّا تَرْتَابُوٓا۟ ۖ إِلَّآ أَن تَكُونَ تِجَـٰرَةً حَاضِرَةً تُدِيرُونَهَا بَيْنَكُمْ فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَلَّا تَكْتُبُوهَا ۗ وَأَشْهِدُوٓا۟ إِذَا تَبَايَعْتُمْ ۚ وَلَا يُضَآرَّ كَاتِبٌ وَلَا شَهِيدٌ ۚ وَإِن تَفْعَلُوا۟ فَإِنَّهُۥ فُسُوقٌۢ بِكُمْ ۗ وَٱتَّقُوا۟ ٱللَّهَ ۖ وَيُعَلِّمُكُمُ ٱللَّهُ ۗ وَٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمٌ","page_number":48,"juz_number":3,"translations":[{"id":97790,"resource_id":20,"text":"O you who have believed, when you contract a debt for a specified term, write it down. And let a scribe write [it] between you in justice. Let no scribe refuse to write as Allāh has taught him. So let him write and let the one who has the obligation [i.e., the debtor] dictate. And let him fear Allāh, his Lord, and not leave anything out of it. But if the one who has the obligation is of limited understanding or weak or unable to dictate himself, then let his guardian dictate in justice. And bring to witness two witnesses from among your men. And if there are not two men [available], then a man and two women from those whom you accept as witnesses - so that if one of them [i.e., the women] errs, then the other can remind her. And let not the witnesses refuse when they are called upon. And do not be [too] weary to write it, whether it is small or large, for its [specified] term. That is more just in the sight of Allāh and stronger as evidence and more likely to prevent doubt between you, except when it is an immediate transaction which you conduct among yourselves. For [then] there is no blame upon you if you do not write it. And take witnesses when you conclude a contract. Let no scribe be harmed or any witness. For if you do so, indeed, it is [grave] disobedience in you. And fear Allāh. And Allāh teaches you. And Allāh is Knowing of all things."}]}}},"/recitations/7/by_ayah/2:282":{"status":200,"json":{"audio_files":[{"verse_key":"2:282","url":"Alafasy/mp3/002282.mp3"}],"pagination":{"per_page":10,"current_page":1,"next_page":null,"total_pages":1,"total_records":1}}},"/chapters/2":{"status":200,"json":{"chapter":{"id":2,"revelation_place":"madinah","revelation_order":87,"bismillah_pre":true,"name_simple":"Al-Baqarah","name_complex":"Al-Baqarah","name_arabic":"البقرة","verses_count":286,"pages":[2,49],"translated_name":{"language_name":"english","name":"The Cow"}}}}}}
